{
  "name": "pixel-office",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@9.15.5",
  "engines": {
    "node": ">=20.19.0",
    "pnpm": ">=9.15.5 <10"
  },
  "scripts": {
    "dev": "pnpm --filter @pixel-office/web dev",
    "build": "pnpm -r run build",
    "lint": "pnpm -r run lint",
    "test": "pnpm -r run test",
    "typecheck": "pnpm -r run typecheck",
    "preview": "pnpm --filter @pixel-office/web preview",
    "assets:build": "pnpm --filter @pixel-office/web assets:build"
  }
}
